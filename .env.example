# Copy to .env and adjust. All variables are optional; see app/config.py.

# Hugging Face id or local checkpoint dir for VLX-Seek-1.5-10B.
VLX_API_MODEL_PATH=omlab/VLX-Seek-1.5-10B

# Explicit device override: cuda:0, npu:0, mps, cpu. Leave unset for
# VLX_SEEK_BACKEND / auto-detection (prefers CUDA, then NPU, then MPS, then CPU).
# VLX_API_DEVICE=cuda:0

# WeDetect-Uni checkpoint for automatic region proposals.
# Defaults to <repo>/resources/wedetect_base_uni.pth and is auto-downloaded.
# VLX_API_DETECTOR_CHECKPOINT=/path/to/wedetect_base_uni.pth

# Serializes model.generate() calls; raise only if you run multiple GPUs/replicas.
VLX_API_MAX_CONCURRENT_INFERENCE=1

# Require `X-API-Key: <value>` on all /v1/* routes. Unset disables auth.
# VLX_API_API_KEY=change-me

# Load the model at process startup instead of on first request.
VLX_API_LOAD_MODEL_ON_STARTUP=false

VLX_API_LOG_LEVEL=info
VLX_API_HOST=0.0.0.0
VLX_API_PORT=8000
